/* The panel's 5x7 font: the SDK has no text support, so the glyphs live here
 * and text() draws one line into a small buffer and blits it in one transfer.
 * Bit 4 is the leftmost of five columns; the sixth is the gap between glyphs.
 */

/* --- font ----------------------------------------------------------------- */

static const char glyph_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 -./:+(),<>%#";

/* One byte per row, top row first; bit 4 is the leftmost column. */
static const uint8_t glyph_rows[][7] = {
